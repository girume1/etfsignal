
# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE — consumed only by /api/analyze (Vercel serverless function)
# NEVER add a VITE_ prefix here — these keys must not reach the browser
# ─────────────────────────────────────────────────────────────────

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE — SoSoValue ETF data
# Apply for a key: https://forms.gle/2nuJT2qNbUQsyyZy8
# Variable name matches SoSoValue's own docs: export SOSO_API_KEY=<key>
# ─────────────────────────────────────────────────────────────────
SOSO_API_KEY=your_sosovalue_api_key_here

# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE — SoDEX trading (mainnet by default)
# Set SODEX_NETWORK=testnet to route to the testnet gateway instead
# ─────────────────────────────────────────────────────────────────
SODEX_PRIVATE_KEY=0x_your_wallet_private_key_here
# SODEX_NETWORK=testnet

# ─────────────────────────────────────────────────────────────────
# CLIENT-SIDE — SoDEX network for the browser wallet (must match server)
# Set to "testnet" if SODEX_NETWORK=testnet above
# ─────────────────────────────────────────────────────────────────
# VITE_SODEX_NETWORK=testnet

VITE_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id_here
