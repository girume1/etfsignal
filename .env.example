# ── ETFSignal AI — Environment Variables ─────────────────────────────────────
# Copy this to .env.local for local development (never commit .env.local)
# For Vercel: add these in Project Settings → Environment Variables

# ── Core API Keys (server-side only, no VITE_ prefix) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SOSOVALUE_API_KEY=...

# ── Telegram Bot (Wave 2) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REDACTED_BOT_TOKEN

# Comma-separated chat IDs to receive automatic signal alerts
# Get your chat ID by sending /start to @ETFSignalAIBot and noting the ID shown
TELEGRAM_SUBSCRIBER_IDS=

# Optional: shared secret for /api/telegram-notify endpoint security
# TELEGRAM_NOTIFY_SECRET=your-random-secret-here
