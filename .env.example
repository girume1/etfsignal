# ── ETFSignal AI — Environment Variables ─────────────────────────────────────
# Copy to .env.local for local dev. Set these on Vercel for production.
# NEVER commit real keys — .env.local is gitignored.

# ── Core API Keys (server-side only, no VITE_ prefix) ──────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SOSOVALUE_API_KEY=your_sosovalue_api_key_here

# ── Telegram Bot (Wave 2) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated chat IDs for automatic signal alerts
# Get your chat ID by sending /start to the bot
TELEGRAM_SUBSCRIBER_IDS=

# Optional: shared secret for /api/telegram-notify endpoint
# TELEGRAM_NOTIFY_SECRET=your_random_secret_here
