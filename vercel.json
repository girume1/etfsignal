{
  "installCommand": "npm install && cd app && npm install --legacy-peer-deps",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/telegram-link", "destination": "/api/telegram?_route=link" },
    { "source": "/api/telegram-notify", "destination": "/api/telegram?_route=notify" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
